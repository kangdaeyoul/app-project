{
  "name": "@jongro/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --import ./test/environment.cjs --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "materials:migrate": "tsx scripts/materials-migrate.ts",
    "materials:import-backup": "tsx scripts/materials-import-backup.ts"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@jongro/shared": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@xmldom/xmldom": "^0.9.12",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0"
  }
}
