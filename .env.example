# Set these in the deployment service. No secrets are required for sample-only demo.
NODE_ENV=production
PORT=3000
API_URL=http://127.0.0.1:4000
# Explicitly enable only for public testing with sample data.
DEMO_LOGIN_ENABLED=false
# HTTPS public deployments: true. Local HTTP preview: false.
AUTH_SECURE_COOKIE=true

# Optional API diagnostic classification; never logs credentials
AUTH_DIAGNOSTICS=false

# Material catalog only; choose PostgreSQL for Render production after migration approval.
MATERIAL_STORAGE=postgres
# Secret value must be supplied by the deployment service. Never commit credentials.
MATERIAL_DATABASE_URL=
MATERIAL_DB_SSL=false
MATERIAL_SEED_SAMPLES=false
# Local SQLite preview uses repository .local/materials.sqlite by default.
# MATERIAL_STORAGE=sqlite
# MATERIAL_SQLITE_PATH=/absolute/private/path/materials.sqlite
